---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import PortfolioLayout from '@/layouts/PortfolioLayout.astro';
import TableOfContents from '@/components/TableOfContents.astro';
import Giscus from '@/components/Giscus.astro';
import Bookmark from '@/components/Bookmark.astro';
import { toTOCItems } from '@/utils/extractTOC';
import dayjs from 'dayjs';

export const getStaticPaths = (async () => {
  const posts = await getCollection('posts');
  return posts.map((post) => ({
    params: { slug: post.data.slug.replace(/^\//, '') },
    props: { post },
  }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const { Content, headings } = await render(post);
const toc = toTOCItems(headings);

const formattedDate = dayjs(post.data.lastEditedTime).format('YYYY년 MM월 DD일');
---

<PortfolioLayout title={post.data.title} description={post.data.description}>
  <main class="flex w-full flex-col items-center">
    <article class="w-full max-w-3xl">
      <a
        class="group/link mb-8 inline-flex items-baseline text-sm font-medium text-stone-400 hover:text-accent-400"
        href="/posts"
      >
        ← Back to Posts
      </a>

      <header class="mb-12 flex flex-col gap-6 border-b border-stone-700/40 pb-8">
        <div class="flex flex-row flex-wrap gap-2">
          {post.data.categories.map((item) => (
            <span class="rounded-full bg-accent-500/20 px-3 py-1 text-xs font-semibold text-accent-300">
              {item.name}
            </span>
          ))}
        </div>
        <h1 class="text-3xl font-bold leading-tight tracking-tight text-balance text-stone-100 sm:text-4xl lg:text-5xl">
          {post.data.title}
        </h1>
        {post.data.description && (
          <p class="text-lg leading-relaxed text-stone-400">
            {post.data.description}
          </p>
        )}
        <time class="text-sm text-stone-500">{formattedDate}</time>
      </header>

      <TableOfContents toc={toc} />

      <div
        id="post"
        class="prose prose-lg prose-invert max-w-none prose-headings:text-stone-200 prose-p:text-stone-400 prose-a:text-accent-400 prose-strong:text-stone-200 prose-code:text-accent-300 prose-pre:bg-stone-800/50 prose-pre:border prose-pre:border-stone-700/50"
      >
        <Content components={{ Bookmark }} />
      </div>

      <Giscus />
    </article>
  </main>
</PortfolioLayout>
