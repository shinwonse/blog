---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import PortfolioLayout from '@/layouts/PortfolioLayout.astro';
import ArrowUpRightIcon from '@/components/icons/ArrowUpRightIcon.astro';

export const getStaticPaths = (async ({ paginate }) => {
  const posts = (await getCollection('posts')).sort(
    (a, b) =>
      new Date(b.data.lastEditedTime).getTime() -
      new Date(a.data.lastEditedTime).getTime(),
  );
  return paginate(posts, { pageSize: 12 });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const posts = page.data;
const isFirstPage = page.currentPage === 1;
---

<PortfolioLayout title="Blog" description="개발하며 배우고 느낀 것들을 기록합니다">
  <header class="mb-16">
    <a
      class="group/link inline-flex items-baseline text-sm font-medium text-stone-400 hover:text-accent-400"
      href="/"
    >
      ← Back to Home
    </a>
    <h1 class="mt-8 text-4xl font-bold tracking-tight text-stone-100 sm:text-5xl">
      Blog
    </h1>
    <p class="mt-4 max-w-xl text-base text-stone-400">
      개발하며 배우고 느낀 것들을 기록합니다
    </p>
  </header>

  <main>
    <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
      {posts.map((post, index) => {
        const isWide = index === 0 && isFirstPage;
        const slug = post.data.slug.replace(/^\//, '');
        return (
          <article
            class:list={[
              'group relative flex flex-col justify-end overflow-hidden rounded-2xl',
              'border border-stone-800/50 bg-stone-900 transition-all',
              'hover:scale-[1.01] hover:shadow-2xl hover:shadow-accent-500/20',
              isWide ? 'min-h-[300px] md:col-span-2' : 'min-h-[280px]',
            ]}
          >
            <div class="absolute inset-0 z-0 h-full w-full">
              <div
                class="h-full w-full bg-linear-to-br from-stone-800 via-stone-900 to-stone-950 opacity-60 transition-transform duration-700 group-hover:scale-105"
              />
              <div
                class="absolute inset-0 bg-linear-to-t from-stone-950 via-stone-900/80 to-transparent"
              />
            </div>

            <div class="z-10 flex flex-col justify-between p-6 sm:p-8">
              <header class="mb-2">
                <div class="mb-3 flex flex-wrap gap-2">
                  {post.data.categories.slice(0, 3).map((tag) => (
                    <span class="rounded-full bg-accent-500/20 px-2.5 py-0.5 text-xs font-semibold text-accent-300 backdrop-blur-sm">
                      {tag.name}
                    </span>
                  ))}
                </div>
                <span class="mb-1 block text-xs font-semibold uppercase tracking-wide text-stone-400">
                  {new Date(post.data.createdTime).toISOString().slice(0, 10)}
                </span>
              </header>

              <div>
                <h3 class="mb-3 text-xl font-bold leading-tight text-stone-100 sm:text-2xl">
                  <a class="focus:outline-none" href={`/posts/${slug}`}>
                    <span aria-hidden="true" class="absolute inset-0" />
                    <span
                      class="bg-linear-to-r from-stone-100 to-stone-300 bg-clip-text text-transparent transition-all duration-300 group-hover:from-accent-200 group-hover:to-accent-500"
                    >
                      {post.data.title}
                    </span>
                  </a>
                </h3>
                <p class="line-clamp-2 text-sm leading-relaxed text-stone-300/80">
                  {post.data.description}
                </p>
              </div>

              <div
                class="mt-4 flex translate-y-2 transform items-center text-sm font-medium text-accent-400 opacity-0 transition-all duration-300 group-hover:translate-y-0 group-hover:opacity-100"
              >
                Read Article <span class="ml-1"><ArrowUpRightIcon /></span>
              </div>
            </div>
          </article>
        );
      })}
    </div>

    {(page.url.prev || page.url.next) && (
      <nav class="mt-16 flex items-center justify-center gap-2">
        {page.url.prev && (
          <a
            href={page.url.prev}
            class="inline-flex h-9 items-center gap-1 rounded-md border border-stone-700 bg-stone-800/50 px-4 text-sm text-stone-300 hover:bg-stone-700 hover:text-stone-100"
          >
            ← Previous
          </a>
        )}

        <span class="px-3 text-sm text-stone-400">
          Page {page.currentPage} of {page.lastPage}
        </span>

        {page.url.next && (
          <a
            href={page.url.next}
            class="inline-flex h-9 items-center gap-1 rounded-md border border-stone-700 bg-stone-800/50 px-4 text-sm text-stone-300 hover:bg-stone-700 hover:text-stone-100"
          >
            Next →
          </a>
        )}
      </nav>
    )}
  </main>
</PortfolioLayout>
