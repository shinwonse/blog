---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="404" description="페이지를 찾을 수 없습니다">
  <div class="flex min-h-screen flex-col items-center justify-center bg-stone-900">
    <main class="flex flex-col items-center gap-8 text-center">
      <h1 class="text-8xl font-bold text-stone-200">404</h1>
      <p class="text-xl text-stone-400">페이지를 찾을 수 없습니다</p>
      <a
        class="bg-accent-400/10 text-accent-400 hover:bg-accent-400/20 rounded-full px-6 py-3 text-sm font-medium transition-colors"
        href="/"
      >
        홈으로 돌아가기
      </a>
    </main>
  </div>
</BaseLayout>
