---
import type { Project } from '@/data/portfolio';
import ArrowUpRightIcon from '@/components/icons/ArrowUpRightIcon.astro';

interface Props {
  data: Project;
}

const { data } = Astro.props;
---

<div
  class="group relative grid gap-4 pb-1 transition-all sm:grid-cols-8 sm:gap-8 md:gap-4 lg:hover:opacity-100! lg:group-hover/list:opacity-50"
>
  <div
    class="absolute -inset-x-4 -inset-y-4 z-0 hidden rounded-md transition motion-reduce:transition-none lg:-inset-x-6 lg:block lg:group-hover:bg-stone-800/50 lg:group-hover:shadow-[inset_0_1px_0_0_rgba(148,163,184,0.1)] lg:group-hover:drop-shadow-lg"
  />
  <div class="z-10 sm:order-2 sm:col-span-6">
    <h3>
      {data.link ? (
        <a
          class="group/link inline-flex items-baseline text-base font-medium leading-tight text-stone-200 hover:text-accent-400 focus-visible:text-accent-400"
          href={data.link}
          target="_blank"
          rel="noreferrer"
          aria-label={data.title}
        >
          <span
            class="absolute -inset-x-4 -inset-y-2.5 hidden rounded md:-inset-x-6 md:-inset-y-4 lg:block"
          />
          <span>
            {data.title} <ArrowUpRightIcon />
          </span>
        </a>
      ) : (
        <span class="text-base font-medium leading-tight text-stone-200">
          {data.title}
        </span>
      )}
    </h3>
    <div class="mt-2 text-sm leading-normal text-stone-400">
      <ul class="list-disc space-y-1 pl-4">
        {data.description.map((point) => (
          <li>{point}</li>
        ))}
      </ul>
    </div>
    <ul class="mt-2 flex flex-wrap" aria-label="Technologies used">
      {data.technologies.map((tech) => (
        <li class="mr-1.5 mt-2">
          <div class="flex items-center rounded-full bg-accent-400/10 px-3 py-1 text-xs font-medium leading-5 text-accent-400">
            {tech}
          </div>
        </li>
      ))}
    </ul>
  </div>
  <div
    class="z-10 mt-1 text-xs font-semibold uppercase tracking-wide text-stone-500 sm:order-1 sm:col-span-2"
  >
    <p class="whitespace-nowrap">{data.period}</p>
    {data.organization && (
      <p class="mt-1 font-normal text-stone-400">{data.organization}</p>
    )}
  </div>
</div>
