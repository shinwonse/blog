  class={className}
  xmlns="http://www.w3.org/2000/svg"
  width="20"
  height="20"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <rect x="2" y="2" width="20" height="20" rx="3" ry="3" />
  <path d="M8 7v10M8 7l8 10M16 7v10" />
</svg>
